; Engine configuration file.
config_version=5

[application]

config/name="Riftstrike"
config/description="RIFTSTRIKE — turn-based 6vN rift brawl. Godot port of the canvas web game."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.113725, 0.231373, 0.227451, 1)
boot_splash/show_image=false
config/icon="res://assets/deco/03.png"
run/low_processor_mode=false

[display]

window/size/viewport_width=1024
window/size/viewport_height=576
window/stretch/mode="disabled"
window/handheld/orientation=6
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.278431, 0.670588, 0.662745, 1)
2d/snap/snap_2d_transforms_to_pixel=false
